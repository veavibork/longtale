# 32-byte hex secret that encrypts each user's stored provider API keys at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=

PORT=4113
# Loopback by default; set to 0.0.0.0 only behind a reverse proxy.
HOST=127.0.0.1

# Optional: where the SQLite files and logs live (default ./data).
# LONGTALE_DATA_DIR=
